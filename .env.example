APP_NAME=Jiraya Personal Assistant
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_TIMEOUT_SECONDS=60

DATABASE_URL=postgresql+psycopg://jiraya:jiraya_dev_password@localhost:5432/jiraya
ENABLE_EXTERNAL_ACTIONS=false

# Phase 2D uses one local development user until real Jiraya sign-in is added.
DEV_USER_ID=local-dev-user
DEV_USER_EMAIL=local@jiraya.dev

# Generate locally; never commit your real key.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Create a Google OAuth client of type "Web application" in the Jiraya Google Cloud project.
# Authorized redirect URI for local development:
# http://127.0.0.1:8000/connections/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/connections/google/callback

# Legacy desktop Gmail OAuth remains as a development fallback while migrating.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_CLASSIFICATION_THRESHOLD=0.85
GMAIL_REPLY_TEMPLATE_PATH=app/templates/internship_reply.txt
GMAIL_REPLY_SIGNATURE=Nityant

# TEMPLATE ONLY — DO NOT PUT REAL CREDENTIALS OR PRODUCTION IDENTIFIERS IN THIS FILE.
# Jiraya runtime reads the local `.env` file, not `.env.example`.
# Copy the variable names you need into `.env` and keep all real values there.

APP_NAME=Jiraya Personal Assistant
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000

# Real value belongs in .env only.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_TIMEOUT_SECONDS=60

DATABASE_URL=postgresql+psycopg://jiraya:jiraya_dev_password@localhost:5432/jiraya
ENABLE_EXTERNAL_ACTIONS=false
# embedded: one API process runs the monitors (simplest always-on deployment).
# external: API serves requests only; run ONE `python -m app.runtime.worker` separately.
AUTOMATION_RUNTIME_MODE=embedded
# Required for embedded mode: do not duplicate monitors across API processes.
WEB_CONCURRENCY=1

DEV_USER_ID=local-dev-user
DEV_USER_EMAIL=local@jiraya.dev

# Generate locally and store the generated value in .env only.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Create a Google OAuth client of type "Web application" in the Jiraya Google Cloud project.
# Keep the REAL client ID and client secret in .env only. Never paste them here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/connections/google/callback
# Add this second redirect URI to the SAME Google Web OAuth client for Calendar.
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/connections/google/calendar/callback

# Register a GitHub OAuth App for Jiraya. Keep the real values in .env only.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/connections/github/callback
GITHUB_OAUTH_SCOPES=repo workflow read:user
GITHUB_API_BASE_URL=https://api.github.com

GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_CLASSIFICATION_THRESHOLD=0.85
GMAIL_REPLY_TEMPLATE_PATH=app/templates/internship_reply.txt
GMAIL_REPLY_SIGNATURE=Nityant

# Automatic local/server monitor. This consumes Gmail history without requiring a button press.
GMAIL_BACKGROUND_MONITOR_ENABLED=true
GMAIL_BACKGROUND_POLL_SECONDS=15

# Optional production push wake-up. Keep project-specific topic names and the real webhook
# token in .env. These remain blank in the tracked template.
GMAIL_PUBSUB_TOPIC_NAME=
GMAIL_PUBSUB_WEBHOOK_TOKEN=
GMAIL_WATCH_AUTO_REGISTER=true

# Calendar event-change monitoring (independent of Gmail)
CALENDAR_BACKGROUND_MONITOR_ENABLED=true
CALENDAR_BACKGROUND_POLL_SECONDS=30

# GitHub repository monitoring (only explicitly configured repositories)
GITHUB_BACKGROUND_MONITOR_ENABLED=true
GITHUB_BACKGROUND_POLL_SECONDS=60

# Application-owner deployment settings. End users sign in through the frontend.
AUTH_REQUIRED=true
SESSION_DAYS=7
# Production enables secure cookies automatically when APP_ENV=production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
REGISTRATION_ENABLED=true

# Optional Hermes read-only developer briefing pilot (operator setup only).
# Use a dedicated profile with ALL native toolsets disabled and a private API route.
# Owner is the Jiraya user ID shown by GET /auth/me; never share one profile across users.
HERMES_BRIEFING_ENABLED=false
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_OWNER_USER_ID=
HERMES_TIMEOUT_SECONDS=60

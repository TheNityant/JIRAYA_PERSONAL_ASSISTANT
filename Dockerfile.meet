# Separate background worker. Do not replace the existing FastAPI Dockerfile.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends pulseaudio ffmpeg tini && \
    useradd --create-home jiraya && rm -rf /var/lib/apt/lists/*
# Source edits must not invalidate Python/browser/system dependency downloads.
COPY pyproject.toml ./
RUN python -c 'import tomllib; p=tomllib.load(open("pyproject.toml","rb")); print("\n".join(p["build-system"]["requires"] + p["project"]["dependencies"] + p["project"]["optional-dependencies"]["cloud-meet"]))' > /tmp/meet-requirements.txt && \
    pip install --no-cache-dir -r /tmp/meet-requirements.txt && \
    python -m playwright install --with-deps chromium && \
    chmod -R a+rX /ms-playwright && rm -rf /var/lib/apt/lists/* /tmp/meet-requirements.txt
COPY README.md ./
COPY app ./app
RUN pip install --no-cache-dir --no-deps --no-build-isolation .
USER jiraya
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-c", "pulseaudio --daemonize=yes --exit-idle-time=-1 && exec python -m app.meet_cloud.worker"]

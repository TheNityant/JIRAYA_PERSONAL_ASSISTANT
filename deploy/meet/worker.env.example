# Copy to .env.meet at the repository root, chmod 600, and fill on the AWS host.
# Plain values, without quotes; compose's raw format preserves $ characters.
APP_ENV=production
MEET_CLOUD_ENABLED=true
ENABLE_EXTERNAL_ACTIONS=true
MEET_CLOUD_MAX_MINUTES=120
MEET_CLOUD_RETENTION_DAYS=7
ASSEMBLYAI_API_KEY=REPLACE_WITH_ASSEMBLYAI_KEY
ASSEMBLYAI_SPEECH_MODEL=universal-streaming-english
# Same database used by the Render API. Use EXTERNAL hostname and TLS from AWS.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@EXTERNAL_HOST/DATABASE?sslmode=require
# Copy the EXISTING key. Generating a different one breaks token decryption.
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_RENDER_KEY
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_EXISTING_RENDER_VALUE
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_EXISTING_RENDER_VALUE
# Keep both existing callback URLs; never point these at the AWS worker.
GOOGLE_OAUTH_REDIRECT_URI=REPLACE_WITH_EXISTING_RENDER_VALUE
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=REPLACE_WITH_EXISTING_RENDER_VALUE
NEBIUS_API_KEY=REPLACE_WITH_EXISTING_KEY
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Copy the working Render model value if different.
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Google-account attendance and authenticated frontend browser setup (one worker).
MEET_CLOUD_IDENTITY_MODE=google_profile
MEET_CLOUD_PROFILE_ROOT=/home/jiraya/google_profiles

MEET_CLOUD_BROWSER_PORTAL_ENABLED=true

{
  "name": "jiraya-workspace",
  "displayName": "Jiraya Workspace Checkpoint",
  "description": "Register open local Git projects with Jiraya and checkpoint enabled repositories together.",
  "version": "0.5.0",
  "publisher": "jiraya-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jiraya.addProjects",
        "title": "Jiraya: Add Git Projects"
      },
      {
        "command": "jiraya.pair",
        "title": "Jiraya: Pair Local Companion"
      },
      {
        "command": "jiraya.checkpoint",
        "title": "Jiraya: Checkpoint Enabled Open Projects"
      },
      {
        "command": "jiraya.diagnose",
        "title": "Jiraya: Show Workspace Diagnostics"
      },
      {
        "command": "jiraya.setupCompanion",
        "title": "Jiraya: Set Up Local Companion"
      },
      {
        "command": "jiraya.stopCompanion",
        "title": "Jiraya: Stop Local Companion"
      }
    ],
    "configuration": {
      "title": "Jiraya Workspace",
      "properties": {
        "jiraya.companionPort": {
          "type": "number",
          "default": 8765,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "description": "Local companion port."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  }
}
